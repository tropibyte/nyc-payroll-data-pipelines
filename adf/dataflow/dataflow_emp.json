{
    "name": "dataflow_emp",
    "properties": {
        "type": "MappingDataFlow",
        "typeProperties": {
            "sources": [
                {
                    "dataset": {
                        "referenceName": "ds_adls_emp",
                        "type": "DatasetReference"
                    },
                    "name": "srcEmpFile"
                }
            ],
            "sinks": [
                {
                    "dataset": {
                        "referenceName": "ds_sql_emp",
                        "type": "DatasetReference"
                    },
                    "name": "sinkEmpTable"
                }
            ],
            "transformations": [],
            "scriptLines": [
                "source(output(",
                "\t\tEmployeeID as string,",
                "\t\tLastName as string,",
                "\t\tFirstName as string",
                "\t),",
                "\tallowSchemaDrift: true,",
                "\tvalidateSchema: false,",
                "\tignoreNoFilesFound: false) ~> srcEmpFile",
                "srcEmpFile sink(allowSchemaDrift: true,",
                "\tvalidateSchema: false,",
                "\tdeletable:false,",
                "\tinsertable:true,",
                "\tupdateable:false,",
                "\tupsertable:false,",
                "\ttruncate:true,",
                "\tformat: 'table',",
                "\tskipDuplicateMapInputs: true,",
                "\tskipDuplicateMapOutputs: true,",
                "\terrorHandlingOption: 'stopOnFirstError') ~> sinkEmpTable"
            ]
        }
    }
}
